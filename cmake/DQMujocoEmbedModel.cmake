#---------------------------------------------------------------------------------------------------
# dq_mujoco_embed_model: compile a MuJoCo model (XML and assets) into a C++ function that returns
# it as a DQ_MujocoModel, so that it can be loaded without files.
#
#   dq_mujoco_embed_model(<target>
#       FUNCTION  <name>            # C++ function: DQ_robotics_extensions::embedded_models::<name>()
#       DIRECTORY <dir>             # directory of the model
#       MAIN      <file.xml>        # main XML file, directly in DIRECTORY
#       [ASSETS   <files>...]       # meshes, textures, <include> files, relative to DIRECTORY,
#                                   # i.e., the paths as MuJoCo resolves them (meshdir + file)
#   )
#
# The source is generated at build time, and regenerated when any of the files changes. Declare the
# function where it is used:
#   namespace DQ_robotics_extensions::embedded_models { DQ_MujocoModel <name>(); }
#
# This file also runs in script mode (cmake -P) to generate the source.
#---------------------------------------------------------------------------------------------------

if(NOT CMAKE_SCRIPT_MODE_FILE)

function(dq_mujoco_embed_model target)
    cmake_parse_arguments(ARG "" "FUNCTION;DIRECTORY;MAIN" "ASSETS" ${ARGN})
    if(NOT ARG_FUNCTION OR NOT ARG_DIRECTORY OR NOT ARG_MAIN)
        message(FATAL_ERROR "dq_mujoco_embed_model: FUNCTION, DIRECTORY and MAIN are required")
    endif()
    # MuJoCo resolves the assets relative to the main XML, and their names are relative to DIRECTORY
    if(ARG_MAIN MATCHES "/")
        message(FATAL_ERROR "dq_mujoco_embed_model: MAIN (${ARG_MAIN}) must be directly in DIRECTORY")
    endif()

    # This file, which also generates the source in script mode
    set(script ${CMAKE_CURRENT_FUNCTION_LIST_FILE})
    set(output ${CMAKE_CURRENT_BINARY_DIR}/embedded_models/${ARG_FUNCTION}.cpp)
    set(dependencies ${ARG_DIRECTORY}/${ARG_MAIN})
    foreach(asset IN LISTS ARG_ASSETS)
        list(APPEND dependencies ${ARG_DIRECTORY}/${asset})
    endforeach()
    # Lists cannot be passed through -D, so the assets are separated by "|"
    string(REPLACE ";" "|" assets "${ARG_ASSETS}")

    add_custom_command(
        OUTPUT ${output}
        COMMAND ${CMAKE_COMMAND}
                -DOUTPUT=${output}
                -DFUNCTION=${ARG_FUNCTION}
                -DDIRECTORY=${ARG_DIRECTORY}
                -DMAIN=${ARG_MAIN}
                -DASSETS=${assets}
                -P ${script}
        DEPENDS ${dependencies} ${script}
        COMMENT "Embedding the MuJoCo model ${ARG_MAIN} (${ARG_FUNCTION})"
        VERBATIM
    )
    target_sources(${target} PRIVATE ${output})
endfunction()

else()

# Script mode: write OUTPUT
string(REPLACE "|" ";" ASSETS "${ASSETS}")

# 16 bytes (32 hex digits) per line
set(line_pattern "")
foreach(i RANGE 1 32)
    string(APPEND line_pattern "[0-9a-f]")
endforeach()

# Appends to "arrays" a C++ array named <variable> with the bytes of <file>. A trailing zero byte is
# added so that empty files are valid arrays; it is excluded from the size.
function(append_array variable file)
    if(NOT EXISTS ${file})
        message(FATAL_ERROR "dq_mujoco_embed_model: ${file} does not exist")
    endif()
    file(READ ${file} hex HEX)
    string(REGEX REPLACE "(${line_pattern})" "\\1\n" hex "${hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    set(arrays "${arrays}const unsigned char ${variable}[] = {\n${hex}0x00};\n\n" PARENT_SCOPE)
endfunction()

set(arrays "")
append_array(file_main ${DIRECTORY}/${MAIN})
set(assets_code "")
set(index 0)
foreach(asset IN LISTS ASSETS)
    append_array(file_${index} ${DIRECTORY}/${asset})
    string(APPEND assets_code
        "    model.assets.emplace(\"${asset}\", std::vector<unsigned char>(file_${index}, file_${index} + sizeof(file_${index}) - 1));\n")
    math(EXPR index "${index} + 1")
endforeach()

file(WRITE ${OUTPUT}.tmp
"// Generated by cmake/DQMujocoEmbedModel.cmake from ${DIRECTORY}. Do not edit.
#include <dqrobotics_extensions/interfaces/mujoco/DQ_MujocoModel.h>

namespace
{

${arrays}}

namespace DQ_robotics_extensions::embedded_models
{

DQ_MujocoModel ${FUNCTION}();

DQ_MujocoModel ${FUNCTION}()
{
    DQ_MujocoModel model;
    model.name = \"${MAIN}\";
    model.xml.assign(reinterpret_cast<const char*>(file_main), sizeof(file_main) - 1);
${assets_code}    return model;
}

}
")
# Only touch the output when it changes, to avoid needless recompilation
file(COPY_FILE ${OUTPUT}.tmp ${OUTPUT} ONLY_IF_DIFFERENT)
file(REMOVE ${OUTPUT}.tmp)

endif()
