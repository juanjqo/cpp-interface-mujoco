<mujoco model="generic 6-DoF manipulator">
  <!--
    A generic 6-DoF manipulator built only from primitive shapes (no mesh files). Part of the robots
    library: load it with GenericManipulatorRobot::description() (see GenericManipulatorRobot.h).

    Kinematics (all lengths in meters), shown at q = 0, where the arm points straight up:
      joint1  base yaw       axis z   at height 0.10
      joint2  shoulder pitch axis y   at height 0.25
      joint3  elbow pitch    axis y   0.40 above the shoulder
      joint4  wrist roll     axis z   0.35 above the elbow
      joint5  wrist pitch    axis y   0.10 above joint4
      joint6  flange roll    axis z   0.10 above joint5
    The "end_effector" site is 0.06 above joint6. The "target" site is a free-standing
    frame in the world (not part of the robot) that the examples move around.

    Every joint is driven by a position actuator (a PD controller in MuJoCo). The "home" keyframe
    bends the arm (q = 0, 0.5, 1.2, 0, 1.0, 0), and its ctrl makes the actuators hold that pose.
  -->
  <compiler angle="radian" autolimits="true"/>

  <option timestep="0.002" integrator="implicitfast"/>

  <statistic center="0 0 0.5" extent="1.2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="base" rgba="0.25 0.25 0.28 1"/>
    <material name="link" rgba="0.85 0.85 0.88 1"/>
    <material name="joint" rgba="0.15 0.45 0.80 1"/>
  </asset>

  <default>
    <default class="arm">
      <joint damping="2" armature="0.05" range="-3.1416 3.1416"/>
      <!-- the arm collides with the floor (and other objects), but not with itself -->
      <geom contype="2" conaffinity="1" material="link"/>
      <position kp="800" kv="80" ctrlrange="-3.1416 3.1416" forcerange="-150 150"/>
      <default class="wrist">
        <joint damping="0.5" armature="0.01"/>
        <position kp="100" kv="10" forcerange="-30 30"/>
      </default>
      <default class="joint_housing">
        <geom type="cylinder" size="0.055 0.05" material="joint" zaxis="0 1 0"/>
      </default>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" contype="1" conaffinity="3"/>

    <!-- A free-standing reference frame (red sphere) that the examples move with set_site_pose() -->
    <site name="target" type="sphere" size="0.03" rgba="1 0 0 0.5" pos="0.4 0 0.4"/>

    <body name="base" childclass="arm">
      <geom name="base" type="cylinder" size="0.09 0.05" pos="0 0 0.05" material="base"/>

      <body name="link1" pos="0 0 0.10">
        <joint name="joint1" axis="0 0 1"/>
        <geom type="cylinder" size="0.06 0.075" pos="0 0 0.075" material="joint"/>

        <body name="link2" pos="0 0 0.15">
          <joint name="joint2" axis="0 1 0" range="-2.2 2.2"/>
          <geom class="joint_housing"/>
          <geom type="capsule" fromto="0 0 0 0 0 0.40" size="0.045"/>

          <body name="link3" pos="0 0 0.40">
            <joint name="joint3" axis="0 1 0" range="-2.6 2.6"/>
            <geom class="joint_housing" size="0.045 0.045"/>
            <geom type="capsule" fromto="0 0 0 0 0 0.35" size="0.035"/>

            <body name="link4" pos="0 0 0.35" childclass="wrist">
              <joint name="joint4" axis="0 0 1"/>
              <geom type="capsule" fromto="0 0 0 0 0 0.08" size="0.03"/>

              <body name="link5" pos="0 0 0.10">
                <joint name="joint5" axis="0 1 0" range="-2.2 2.2"/>
                <geom class="joint_housing" size="0.035 0.035"/>
                <geom type="capsule" fromto="0 0 0 0 0 0.08" size="0.025"/>

                <body name="link6" pos="0 0 0.10">
                  <joint name="joint6" axis="0 0 1"/>
                  <geom type="cylinder" size="0.03 0.02" pos="0 0 0.02" material="joint"/>
                  <geom type="box" size="0.01 0.04 0.01" pos="0 0 0.05" material="base"/>
                  <site name="end_effector" pos="0 0 0.06" size="0.01"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="joint1" joint="joint1" class="arm"/>
    <position name="joint2" joint="joint2" class="arm"/>
    <position name="joint3" joint="joint3" class="arm"/>
    <position name="joint4" joint="joint4" class="wrist"/>
    <position name="joint5" joint="joint5" class="wrist"/>
    <position name="joint6" joint="joint6" class="wrist"/>
  </actuator>

  <keyframe>
    <key name="home" qpos="0 0.5 1.2 0 1.0 0" ctrl="0 0.5 1.2 0 1.0 0"/>
  </keyframe>
</mujoco>
